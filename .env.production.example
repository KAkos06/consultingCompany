# Production VPS Environment Configuration
# ==============================================================================
# Security: Change all passwords before deploying to a public server!
# ==============================================================================

# 1. SQL Server SA Password
# Must be complex (minimum 8 chars, uppercase, lowercase, numbers, symbols)
MSSQL_SA_PASSWORD=ChangeMe_StrongSqlPass_2026!

# 2. Umbraco Superadmin Credentials
UMBRACO_ADMIN_NAME=Akos Kiss
UMBRACO_ADMIN_EMAIL=akos.kiss.in@gmail.com
UMBRACO_ADMIN_PASSWORD=ChangeMe_StrongUmbracoPass_2026!

# 3. Live Public Domain and Reverse Proxy
# The Caddy reverse proxy will automatically obtain Let's Encrypt SSL certificates for these domains.
UMBRACO_APPLICATION_URL=https://yourdomain.com
CADDY_SITE_ADDRESS=yourdomain.com, www.yourdomain.com

# 4. Standard Web Ports
HTTP_PORT=80
HTTPS_PORT=443

# 5. OpenIddict Transport Security
# Keep 'false' in production because Caddy provides public HTTPS.
OPENIDDICT_DISABLE_TRANSPORT_SECURITY_REQUIREMENT=false

# 6. Content Bootstrap
# Set BOOTSTRAP_CONTENT=true and USYNC_IMPORT_AT_STARTUP=All ONLY on the very first run
# to seed content. Afterwards set them to false and None so backoffice edits are never overwritten.
BOOTSTRAP_CONTENT=true
USYNC_IMPORT_AT_STARTUP=All
