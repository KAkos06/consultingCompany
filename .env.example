# Local Docker defaults. Replace all passwords before any shared deployment.
MSSQL_SA_PASSWORD=LocalOnly!ChangeMe2026
UMBRACO_ADMIN_NAME=Local Admin
UMBRACO_ADMIN_EMAIL=admin@example.test
UMBRACO_ADMIN_PASSWORD=LocalOnly!ChangeMe2026
UMBRACO_APPLICATION_URL=http://localhost:8080

# Set BOOTSTRAP_CONTENT=true and USYNC_IMPORT_AT_STARTUP=All only for the first content seed;
# set them back to false and None afterwards so backoffice edits are never overwritten.
BOOTSTRAP_CONTENT=true
USYNC_IMPORT_AT_STARTUP=All

# Local access is http://localhost:8080. On the VPS use the real domain and 80/443.
CADDY_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
