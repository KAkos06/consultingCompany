@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var currentPage = Model;
    if (currentPage == null || !currentPage.HasProperty("showBreadcrumb") || !currentPage.Value<bool>("showBreadcrumb"))
    {
        return;
    }

    var customName = currentPage.Value<string>("breadcrumbName");
    var currentLabel = !string.IsNullOrWhiteSpace(customName) ? customName : currentPage.Name;

    var ancestors = currentPage.Ancestors().Where(x => x.Level > 1).ToArray();
    Array.Reverse(ancestors);
    
    var breadcrumbs = new List<dynamic>();
    if (ancestors.Length > 0 || currentPage.Level > 1)
    {
        foreach (var a in ancestors)
        {
            breadcrumbs.Add(new { label = a.Name, to = a.Url() });
        }
        breadcrumbs.Add(new { label = currentLabel, to = currentPage.Url() });
    }

    if (breadcrumbs.Count <= 1) // Don't show breadcrumb if it's just the current page on Level 2 (e.g. Home Page)
    {
        return;
    }
}

<style>
    /* Position breadcrumb with safe clearance below the floating header */
    .breadcrumb-wrapper {
        position: absolute;
        top: 104px;
        left: 0;
        right: 0;
        z-index: 40;
        pointer-events: none;
    }
    @@media (min-width: 640px) {
        .breadcrumb-wrapper {
            top: 110px;
        }
    }
    @@media (min-width: 768px) {
        .breadcrumb-wrapper {
            top: 116px;
        }
    }

    /* When breadcrumbs are active, set optimal first section top padding without redundant layout padding */
    main .umb-block-grid__layout-item:first-child > section {
        padding-top: 148px !important;
    }
    @@media (min-width: 640px) {
        main .umb-block-grid__layout-item:first-child > section {
            padding-top: 156px !important;
        }
    }
    @@media (min-width: 768px) {
        main .umb-block-grid__layout-item:first-child > section {
            padding-top: 164px !important;
        }
    }
</style>

<div class="breadcrumb-wrapper">
    <div class="mx-auto max-w-7xl px-6">
        <nav aria-label="Breadcrumb" class="pointer-events-auto inline-flex items-center gap-1.5 text-xs text-white/80 bg-[#1A2A4F]/70 backdrop-blur-md px-4 py-2 rounded-full shadow-sm border border-white/15">
            @for (var i = 0; i < breadcrumbs.Count; i++) {
                var b = breadcrumbs[i];
                var isLast = i == breadcrumbs.Count - 1;
                
                if (!isLast) {
                    if (i == 0 && (b.to == "/" || b.label == "Kezdőlap" || b.label == "Home")) {
                        <a href="@b.to" class="hover:text-white transition-colors inline-flex items-center" aria-label="Kezdőlap" title="Kezdőlap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                        </a>
                    } else {
                        <a href="@b.to" class="hover:text-white transition-colors">@b.label</a>
                    }
                    <span class="opacity-50">/</span>
                } else {
                    <span class="text-white font-medium" aria-current="page">@b.label</span>
                }
            }
        </nav>
    </div>
</div>
