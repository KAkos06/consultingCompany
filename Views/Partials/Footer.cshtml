@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@using Umbraco.Cms.Core.Models;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var siteRoot = Model.Root();
    var settings = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "siteSettings" || x.ContentType.Alias == "settings") 
        ?? siteRoot?.Children.FirstOrDefault(x => x.ContentType.Alias == "siteSettings" || x.ContentType.Alias == "settings")
        ?? siteRoot?.SiblingsAndSelf().FirstOrDefault(x => x.ContentType.Alias == "siteSettings" || x.ContentType.Alias == "settings");
    
    var brandName = settings?.Value<string>("logoText") ?? "Executive Insight";
    var siteLogo = settings?.Value<MediaWithCrops>("siteLogo");
    var footerDesc = settings?.Value<string>("footerDescription") ?? "Vezetői coaching és stratégiai mentorálás C-szintű vezetőknek és vezetői csapatoknak — Budapesten és online.";
    var compTitle = settings?.Value<string>("footerCompanyTitle") ?? "Cég";
    var compLinks = settings?.Value<IEnumerable<Link>>("footerCompanyLinks");
    var servTitle = settings?.Value<string>("footerServicesTitle") ?? "Szolgáltatások";
    var servLinks = settings?.Value<IEnumerable<Link>>("footerServicesLinks");
    
    var newsTitle = settings?.Value<string>("footerNewsletterTitle") ?? "Iratkozz fel";
    var newsText = settings?.Value<string>("footerNewsletterText") ?? "Havi egy mély insight a vezetésről. Spam nélkül.";
    var newsFormGuid = settings?.Value<Guid?>("footerNewsletterForm") ?? Model.Value<Guid?>("footerNewsletterForm");
    
    var copyText = settings?.Value<string>("copyrightText") ?? "© 2025 Executive Insight Kft. Minden jog fenntartva.";
    var bottomLinks = settings?.Value<IEnumerable<Link>>("footerBottomLinks");
    
    var linkedinUrl = settings?.Value<string>("linkedinUrl");
    var twitterUrl = settings?.Value<string>("twitterUrl");
    var instagramUrl = settings?.Value<string>("instagramUrl");
    
    var hasNewsForm = !string.IsNullOrWhiteSpace(newsTitle);
}

<!-- Modern Dark Navy Footer -->
<footer class="bg-[#1A2A4F] text-[#FFF2EF] pt-16 pb-12 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-12 gap-10 pb-16 border-b border-white/10">
      
      <!-- Brand Column -->
      <div class="@(hasNewsForm ? "md:col-span-5" : "md:col-span-8")">
        <div class="flex items-center gap-3 mb-6">
          @if (siteLogo != null && !string.IsNullOrWhiteSpace(siteLogo.Url())) {
            <img src="@siteLogo.Url()" alt="@brandName" class="h-10 w-auto max-h-10 max-w-[140px] object-contain" />
          } else {
            <div class="w-10 h-10 rounded-full bg-[#F7A5A5] text-[#1A2A4F] flex items-center justify-center font-bold text-xl font-[Outfit]">
              EI
            </div>
          }
          <span class="font-[Outfit] font-bold text-2xl text-white">
            @brandName
          </span>
        </div>
        <p class="text-[#FFF2EF]/70 leading-relaxed max-w-sm text-base mb-6">
          @footerDesc
        </p>
        <div class="flex gap-3">
          @if(!string.IsNullOrEmpty(linkedinUrl)) {
            <a href="@linkedinUrl" target="_blank" class="w-10 h-10 rounded-full border border-white/15 flex items-center justify-center font-bold text-xs hover:bg-[#F7A5A5] hover:border-[#F7A5A5] hover:text-[#1A2A4F] transition-all">
              IN
            </a>
          }
          @if(!string.IsNullOrEmpty(twitterUrl)) {
            <a href="@twitterUrl" target="_blank" class="w-10 h-10 rounded-full border border-white/15 flex items-center justify-center font-bold text-xs hover:bg-[#F7A5A5] hover:border-[#F7A5A5] hover:text-[#1A2A4F] transition-all">
              TW
            </a>
          }
          @if(!string.IsNullOrEmpty(instagramUrl)) {
            <a href="@instagramUrl" target="_blank" class="w-10 h-10 rounded-full border border-white/15 flex items-center justify-center font-bold text-xs hover:bg-[#F7A5A5] hover:border-[#F7A5A5] hover:text-[#1A2A4F] transition-all">
              IG
            </a>
          }
        </div>
      </div>

      <!-- Company Column -->
      <div class="md:col-span-2 md:col-start-6">
        <div class="text-xs font-bold uppercase tracking-[0.2em] text-[#FFDBB6] mb-5">
          @compTitle
        </div>
        <ul class="space-y-3 text-sm text-[#FFF2EF]/80">
          @if(compLinks != null) {
            foreach(var link in compLinks) {
              <li><a href="@link.Url" target="@link.Target" class="hover:text-[#F7A5A5] transition-colors">@link.Name</a></li>
            }
          }
        </ul>
      </div>

      <!-- Services Column -->
      <div class="md:col-span-2">
        <div class="text-xs font-bold uppercase tracking-[0.2em] text-[#FFDBB6] mb-5">
          @servTitle
        </div>
        <ul class="space-y-3 text-sm text-[#FFF2EF]/80">
          @if(servLinks != null) {
            foreach(var link in servLinks) {
              <li><a href="@link.Url" target="@link.Target" class="hover:text-[#F7A5A5] transition-colors">@link.Name</a></li>
            }
          }
        </ul>
      </div>

      @if (hasNewsForm) {
      <!-- Newsletter Column -->
      <div class="md:col-span-3">
        <div class="text-xs font-bold uppercase tracking-[0.2em] text-[#FFDBB6] mb-5">
          @newsTitle
        </div>
        <p class="text-sm text-[#FFF2EF]/70 mb-4">
          @newsText
        </p>
        <div class="footer-newsletter-form">
          <form id="footer-newsletter-form" class="flex items-center gap-2 w-full mt-1">
            <input type="email" id="footer-newsletter-email" name="email" required placeholder="te@email.hu" class="w-full rounded-full border px-5 py-3 text-sm transition-all text-[#FFF2EF] outline-none" style="flex: 1 1 auto; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15);" />
            <button type="submit" id="footer-newsletter-submit" class="shrink-0 w-12 h-12 rounded-full bg-[#F7A5A5] text-[#1A2A4F] font-bold text-xl flex items-center justify-center transition-all hover:bg-[#FFDBB6] active:scale-95 shadow-md cursor-pointer" title="Feliratkozás">
              →
            </button>
          </form>
          <div id="footer-newsletter-status" class="mt-2 text-xs transition-all hidden"></div>
        </div>
      </div>
      }
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-[#FFF2EF]/50">
      <div>@copyText</div>
      <div class="flex flex-wrap items-center gap-6">
        @if(bottomLinks != null) {
          foreach(var link in bottomLinks) {
            <a href="@link.Url" target="@link.Target" class="hover:text-[#F7A5A5] transition-colors">@link.Name</a>
          }
        }
        <button type="button" data-cookie-settings class="hover:text-[#F7A5A5] transition-colors cursor-pointer bg-transparent border-0 p-0 text-xs text-[#FFF2EF]/60 hover:underline">Süti beállítások</button>
      </div>
    </div>
  </div>
</footer>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const form = document.getElementById("footer-newsletter-form");
        const emailInput = document.getElementById("footer-newsletter-email");
        const statusEl = document.getElementById("footer-newsletter-status");
        const submitBtn = document.getElementById("footer-newsletter-submit");

        if (form && emailInput && statusEl && submitBtn) {
            form.addEventListener("submit", async function(e) {
                e.preventDefault();
                const email = emailInput.value.trim();
                if (!email) return;

                submitBtn.disabled = true;
                submitBtn.style.opacity = "0.6";
                statusEl.className = "mt-2 text-xs text-[#FFDBB6]";
                statusEl.textContent = "Feliratkozás folyamatban...";
                statusEl.classList.remove("hidden");

                try {
                    const res = await fetch("/api/forms/newsletter", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email: email })
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        statusEl.className = "mt-2 text-xs text-[#86efac]";
                        statusEl.textContent = data.message || "Köszönjük! Sikeres feliratkozás.";
                        emailInput.value = "";
                    } else {
                        statusEl.className = "mt-2 text-xs text-[#fca5a5]";
                        statusEl.textContent = data.message || "Hiba történt a feliratkozás során.";
                    }
                } catch (err) {
                    statusEl.className = "mt-2 text-xs text-[#fca5a5]";
                    statusEl.textContent = "Hálózati hiba történt. Kérjük próbálja újra.";
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = "1";
                }
            });
        }
    });
</script>
