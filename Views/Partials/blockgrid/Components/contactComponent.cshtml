@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ContactComponent>>
@{
    var content = Model.Content;
    var description = content.Description;

    var contactBlocks = content.ContactValues;
    var formGuid = content.Form;

    var bgName = ViewData["bgName"]?.ToString() ?? "";
    var isDark = bgName == "dark" || bgName == "solidDark";

    var eyebrowColor = isDark ? "text-white/50" : "text-[#1A2A4F]/50";
    var titleColor = isDark ? "text-[#FFF2EF]" : "text-[#1A2A4F]";
    var subtitleColor = isDark ? "text-white/70" : "text-[#1A2A4F]/70";
    
    var infoCardBg = isDark ? "bg-white/[0.07] border border-white/10 shadow-[0_24px_48px_-12px_rgba(0,0,0,0.35)] backdrop-blur text-white" : "bg-white shadow-xl shadow-[#1A2A4F]/5";
    var infoTextColor = isDark ? "text-white/70" : "text-[#1A2A4F]/70";
    var iconBoxBg = isDark ? "bg-[#F7A5A5] text-[#1A2A4F]" : "bg-[#FFF2EF] text-[#1A2A4F]";
    var labelColor = isDark ? "text-white/50" : "text-[#1A2A4F]/50";
    var valueColor = isDark ? "text-[#FFF2EF]" : "text-[#1A2A4F]";
    
    var formBg = isDark ? "bg-white/[0.05] border-white/10 text-white shadow-black/30 backdrop-blur" : "bg-[#FFECE8] border-[#F7A5A5]/20 text-[#1A2A4F] shadow-xl";

    var cssText = isDark ? "#FFF2EF" : "#1A2A4F";
    var cssTextRgb = isDark ? "255, 242, 239" : "26, 42, 79";
    var cssInputBg = isDark ? "rgba(255,255,255,0.05)" : "#FFFFFF";
    var cssInputBorder = isDark ? "rgba(255,255,255,0.15)" : "rgba(26, 42, 79, 0.1)";
    var cssBtnBg = isDark ? "#F7A5A5" : "#1A2A4F";
    var cssBtnText = isDark ? "#1A2A4F" : "#FFFFFF";
    var cssBtnHover = isDark ? "#FFDBB6" : "#2A3A5F";
}

<div id="contact" data-testid="contact-section" class="w-full">
    <div class="mx-auto max-w-6xl">

        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-24">
            <div class="fade-up delay-1">
                <div class="space-y-8 rounded-[32px] p-8 md:p-10 @infoCardBg">
                    @if (!string.IsNullOrWhiteSpace(description)) {
                        <p class="mb-8 text-sm leading-relaxed @infoTextColor">
                            @description
                        </p>
                    }
                    <div class="space-y-6">
                        @if (contactBlocks != null && contactBlocks.Any()) {
                            foreach (var block in contactBlocks) {
                                var item = (ContactItem)block.Content;
                                var iconVal = block.Content.GetIconValue("icon");
                                <div class="flex items-start gap-4">
                                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl @iconBoxBg">
                                        @if (iconVal != null && !iconVal.IsEmpty) {
                                            @iconVal.Render(size: 20)
                                        } else {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                        }
                                    </div>
                                    <div>
                                        <div class="text-xs font-semibold uppercase tracking-wider @labelColor">
                                            @item.Label
                                        </div>
                                        <div class="mt-1 font-medium @valueColor">
                                            @item.Value
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="fade-up delay-2" style="--form-text: @cssText; --form-text-rgb: @cssTextRgb; --form-input-bg: @cssInputBg; --form-input-border: @cssInputBorder; --form-btn-bg: @cssBtnBg; --form-btn-text: @cssBtnText; --form-btn-hover: @cssBtnHover;">
                <form id="contact-form" class="space-y-6 rounded-[32px] p-8 border md:p-12 @formBg shadow-xl">
                    <div id="contact-form-status" class="hidden p-4 rounded-2xl text-sm font-medium transition-all"></div>
                    
                    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                        <div class="space-y-2">
                            <label class="text-sm font-semibold" style="color: var(--form-text);">Név *</label>
                            <input type="text" name="name" id="contact-name" required placeholder="Vezetéknév Keresztnév" class="w-full rounded-2xl border px-5 py-4 transition-all outline-none" style="background-color: var(--form-input-bg); border-color: var(--form-input-border); color: var(--form-text);" />
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-semibold" style="color: var(--form-text);">E-mail *</label>
                            <input type="email" name="email" id="contact-email" required placeholder="te@cegednev.hu" class="w-full rounded-2xl border px-5 py-4 transition-all outline-none" style="background-color: var(--form-input-bg); border-color: var(--form-input-border); color: var(--form-text);" />
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-semibold" style="color: var(--form-text);">Cég / Pozíció</label>
                        <input type="text" name="company" id="contact-company" placeholder="pl. CEO, Nordwell Group" class="w-full rounded-2xl border px-5 py-4 transition-all outline-none" style="background-color: var(--form-input-bg); border-color: var(--form-input-border); color: var(--form-text);" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-semibold" style="color: var(--form-text);">Miben segíthetünk? *</label>
                        <textarea name="message" id="contact-message" required rows="2" style="height: 72px; min-height: 72px; max-height: 72px; background-color: var(--form-input-bg); border-color: var(--form-input-border); color: var(--form-text);" placeholder="Pár mondatban a helyzetről, kihívásokról..." class="w-full resize-none rounded-2xl border px-5 py-3 transition-all outline-none"></textarea>
                    </div>
                    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-2">
                        <span class="text-xs" style="color: rgba(var(--form-text-rgb), 0.6);">Üzeneted bizalmas. 24 órán belül válaszolunk.</span>
                        <button type="submit" id="contact-submit-btn" class="w-full md:w-auto flex items-center justify-center gap-2 rounded-full px-8 py-4 text-sm font-bold transition-all active:scale-95 shadow-lg cursor-pointer" style="background-color: var(--form-btn-bg); color: var(--form-btn-text);">
                            <span id="contact-btn-text">Üzenet küldése</span>
                            <svg id="contact-btn-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const form = document.getElementById("contact-form");
        if (!form) return;

        const statusEl = document.getElementById("contact-form-status");
        const submitBtn = document.getElementById("contact-submit-btn");
        const btnText = document.getElementById("contact-btn-text");

        form.addEventListener("submit", async function(e) {
            e.preventDefault();

            const name = document.getElementById("contact-name")?.value.trim();
            const email = document.getElementById("contact-email")?.value.trim();
            const company = document.getElementById("contact-company")?.value.trim();
            const message = document.getElementById("contact-message")?.value.trim();

            if (!name || !email || !message) {
                showStatus("Kérjük, töltse ki a kötelező mezőket!", false);
                return;
            }

            submitBtn.disabled = true;
            submitBtn.style.opacity = "0.7";
            btnText.textContent = "Küldés folyamatban...";
            statusEl.classList.add("hidden");

            try {
                const res = await fetch("/api/forms/contact", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name: name, email: email, company: company, message: message })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    showStatus(data.message || "Köszönjük megkeresését! Hamarosan felvesszük Önnel a kapcsolatot.", true);
                    form.reset();
                } else {
                    showStatus(data.message || "Hiba történt az elküldéskor. Kérjük próbálja újra.", false);
                }
            } catch (err) {
                showStatus("Hálózati hiba történt. Kérjük ellenőrizze az internetkapcsolatot.", false);
            } finally {
                submitBtn.disabled = false;
                submitBtn.style.opacity = "1";
                btnText.textContent = "Üzenet küldése";
            }
        });

        function showStatus(msg, isSuccess) {
            statusEl.textContent = msg;
            statusEl.className = isSuccess 
                ? "p-4 rounded-2xl text-sm font-medium bg-emerald-500/10 text-emerald-700 border border-emerald-500/30"
                : "p-4 rounded-2xl text-sm font-medium bg-rose-500/10 text-rose-700 border border-rose-500/30";
            statusEl.classList.remove("hidden");
        }
    });
</script>

