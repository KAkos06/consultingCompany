@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@{
    var content = Model.Content;
    var milestones = content.Value<Umbraco.Cms.Core.Models.Blocks.BlockListModel>("milestones");

    var bgName = ViewData["bgName"]?.ToString() ?? "";
    var isDark = bgName == "dark" || bgName == "solidDark";

    var eyebrowColor = isDark ? "text-[#FFDBB6]" : "text-[#1A2A4F]/60";
    var titleColor = isDark ? "text-[#FFF2EF]" : "text-[#1A2A4F]";
    var subtitleColor = isDark ? "text-[#FFF2EF]/75" : "text-[#1A2A4F]/70";
    
    var lineColor = isDark ? "bg-white/10" : "bg-[#1A2A4F]/10";
    var dotColor = isDark ? "bg-[#F7A5A5] border-[#1A2A4F]" : "bg-[#1A2A4F] border-white";
    var yearColor = isDark ? "text-[#FFDBB6]" : "text-[#F7A5A5]"; // Accent color for year
    var itemTitleColor = isDark ? "text-[#FFF2EF]" : "text-[#1A2A4F]";
    var itemDescColor = isDark ? "text-[#FFF2EF]/70" : "text-[#1A2A4F]/70";
    var cardBg = isDark ? "bg-white/[0.05] border border-white/10 backdrop-blur" : "bg-white border border-[#1A2A4F]/5 shadow-xl shadow-[#1A2A4F]/5";
}
<div data-testid="timeline-component" class="w-full py-12 md:py-24">
    <div class="mx-auto max-w-6xl px-4">

        @if (milestones != null && milestones.Any()) {
            <div class="relative mx-auto max-w-4xl">
                <!-- Center Line -->
                <div class="absolute left-[20px] top-0 bottom-0 w-px @lineColor md:left-1/2 md:-ml-px"></div>

                @{ var index = 0; }
                @foreach (var block in milestones) {
                    var item = block.Content;
                    var mYear = item.Value<string>("year");
                    var mTitle = item.Value<string>("title");
                    var mDesc = item.Value<string>("description");
                    
                    var isEven = index % 2 == 0;
                    var alignClass = isEven ? "md:pr-12 md:text-right md:ml-0" : "md:pl-12 md:ml-auto";
                    var dotClass = isEven ? "md:right-[-6px]" : "md:left-[-6px]";
                    
                    <div class="relative mb-12 flex flex-col md:flex-row w-full @(isEven ? "md:justify-start" : "md:justify-end") pl-12 md:pl-0 fade-up delay-@index">
                        
                        <!-- Mobile Dot -->
                        <div class="absolute left-[15px] top-6 h-3 w-3 rounded-full border-2 @dotColor md:hidden"></div>
                        
                        <div class="w-full md:w-1/2 @alignClass relative group">
                            <!-- Desktop Dot -->
                            <div class="hidden md:block absolute top-6 h-3 w-3 rounded-full border-2 @dotColor @dotClass transition-transform group-hover:scale-150 group-hover:bg-[#FFDBB6]"></div>

                            <div class="rounded-3xl p-8 transition-all hover:-translate-y-1 hover:shadow-2xl @cardBg">
                                <div class="mb-2 font-[Outfit] text-xl font-bold tracking-widest @yearColor">
                                    @mYear
                                </div>
                                <h3 class="mb-3 text-2xl font-bold @itemTitleColor">
                                    @mTitle
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(mDesc)) {
                                    <p class="leading-relaxed @itemDescColor">
                                        @mDesc
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                    index++;
                }
            </div>
        }
    </div>
</div>
