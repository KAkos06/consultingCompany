@inherits Microsoft.AspNetCore.Mvc.Razor.RazorPage<dynamic>
@{
    Layout = null;
    string pageTitle = Model?.PageTitle ?? "Hamarosan | Executive Insight";
    string title = Model?.Title ?? "Új távlatok a vezetői döntésekben – Hamarosan.";
    string rawText = Model?.Text ?? "Az Executive Insight hivatalos weboldala jelenleg megújul, hogy a legmagasabb szintű szakmai és digitális élményt nyújthassuk partnereinknek.\n\nHamarosan átfogó üzleti megoldásokkal, stratégiai tanácsadással és friss szakmai meglátásokkal jelentkezünk.";
    var paragraphs = rawText.Split(new[] { "\r\n\r\n", "\n\n", "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
}
<!DOCTYPE html>
<html lang="hu" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        h1, h2, h3, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .bg-layer {
            position: fixed;
            inset: -20px;
            background-image: url('/images/maintenance-bg.jpg');
            background-size: cover;
            background-position: center;
            filter: blur(8px) brightness(0.75);
            transform: scale(1.05);
            z-index: -2;
        }
        .overlay-layer {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at center, rgba(15, 23, 42, 0.65) 0%, rgba(10, 15, 30, 0.88) 100%);
            z-index: -1;
        }
        .glass-card {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.6), 0 0 40px rgba(99, 102, 241, 0.1);
        }
    </style>
</head>
<body class="h-full min-h-screen text-slate-100 flex flex-col justify-between overflow-x-hidden">
    <!-- Blurred Background & Gradient Overlay -->
    <div class="bg-layer"></div>
    <div class="overlay-layer"></div>

    <!-- Top Status Indicator -->
    <header class="w-full max-w-6xl mx-auto px-6 py-6 flex items-center justify-end z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs md:text-sm font-medium text-slate-200 backdrop-blur-md">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-500"></span>
            </span>
            <span>Hamarosan indulunk</span>
        </div>
    </header>

    <!-- Main Hero Container -->
    <main class="w-full max-w-6xl mx-auto px-6 py-6 flex-1 flex items-center justify-center z-10">
        <div class="glass-card rounded-3xl p-8 sm:p-12 md:p-14 text-center max-w-5xl w-full">
            
            <!-- Maintenance Icon Badge (Gear & Wrench) -->
            <div class="mx-auto w-16 h-16 rounded-2xl bg-indigo-600/25 border border-indigo-400/30 flex items-center justify-center text-indigo-400 mb-6 shadow-lg shadow-indigo-500/20">
                <svg class="w-9 h-9" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <!-- Gear -->
                    <path d="M21 4h6l1.2 5a15 15 0 0 1 4 1.7l4.6-2.6 4.2 4.2-2.6 4.6a15 15 0 0 1 1.7 4l5 1.2v6l-5 1.2a15 15 0 0 1-1.7 4l2.6 4.6-4.2 4.2-4.6-2.6a15 15 0 0 1-4 1.7L27 44h-6l-1.2-5a15 15 0 0 1-4-1.7l-4.6 2.6-4.2-4.2 2.6-4.6a15 15 0 0 1-1.7-4L2 27v-6l5-1.2a15 15 0 0 1 1.7-4L6.1 11.2l4.2-4.2 4.6 2.6a15 15 0 0 1 4-1.7L21 4z" />
                    <!-- Wrench in center -->
                    <path d="M30 14a6 6 0 0 0-5.8 4.2l-8.5 8.5a3 3 0 1 0 4.2 4.2l8.5-8.5A6 6 0 0 0 34 16.5l-2.5 2.5-2.5-2.5 2.5-2.5z" fill="currentColor" fill-opacity="0.3" stroke-width="2.2" />
                </svg>
            </div>

            <!-- Title -->
            <h1 class="font-heading text-xl sm:text-2xl md:text-3xl font-bold text-white leading-snug tracking-tight mb-6 max-w-4xl mx-auto drop-shadow-sm">
                @title
            </h1>

            <!-- Paragraphs -->
            <div class="space-y-4 text-slate-200 text-base sm:text-lg leading-relaxed mb-8 max-w-3xl mx-auto">
                @foreach (var p in paragraphs)
                {
                    <p>@p</p>
                }
            </div>

            <!-- Value Highlights Pills -->
            <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-300 font-medium">
                <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
                    <span class="text-indigo-400">✦</span> Stratégiai tanácsadás
                </span>
                <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
                    <span class="text-indigo-400">✦</span> Vezetői döntéstámogatás
                </span>
                <span class="px-4 py-2 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
                    <span class="text-indigo-400">✦</span> Digitális transzformáció
                </span>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full max-w-6xl mx-auto px-6 py-6 text-center text-xs text-slate-400/80 z-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <p>&copy; @DateTime.UtcNow.Year Executive Insight. Minden jog fenntartva.</p>
        <span class="hidden sm:inline text-slate-600">·</span>
        <button type="button" data-cookie-settings class="hover:text-slate-200 transition-colors cursor-pointer bg-transparent border-0 p-0 text-xs text-slate-400/80 underline-offset-2 hover:underline">Süti beállítások</button>
    </footer>

    <!-- Cookie Consent Component -->
    @await Html.PartialAsync("CookieConsent")
</body>
</html>
