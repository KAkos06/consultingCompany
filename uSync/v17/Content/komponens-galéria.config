          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "b5555555-1111-1111-1111-111111111111",
                "key": "fe34faf6-53b0-46bb-a4ab-052cd40e9efb",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
