                    "value": "2022"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "50\u002B Sikeres Strat\u00E9giai Projekt"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Nagyv\u00E1llalati \u00E9s scale-up \u00FCgyfelek t\u00E1mogat\u00E1sa szervezeti \u00E1tszervez\u00E9sekben."
                  }
                ]
              },
