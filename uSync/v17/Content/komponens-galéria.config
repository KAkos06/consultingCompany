    {
      "contentTypeKey": "b6666666-6666-6666-6666-666666666666",
      "key": "6b9745d1-8e30-4eb8-a9b0-033ee4ac24a2",
      "values": [
        {
          "alias": "bottomStripTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "K\u00E9szen \u00E1llsz a szintl\u00E9p\u00E9sre?"
        },
        {
          "alias": "bottomStripDesc",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "K\u00E9rj egy k\u00F6tetlen, 30 perces egyeztet\u00E9st, ahol megvizsg\u00E1ljuk, miben tudunk a leggyorsabban seg\u00EDteni."
        },
        {
          "alias": "steps",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "2e31677a-c5ef-4edf-b95c-6cf251554d91",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Diagnosztika"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Felm\u00E9rj\u00FCk a kontextust, kih\u00EDv\u00E1sokat \u00E9s a k\u00EDv\u00E1nt eredm\u00E9nyeket \u2014 struktur\u00E1lt interj\u00FA \u00E9s 360\u00B0 visszajelz\u00E9s alapj\u00E1n."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "17c007fa-bc1c-44a5-8019-b0811a528f71",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Meg\u00E1llapod\u00E1s"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00F6z\u00F6sen r\u00F6gz\u00EDtj\u00FCk a f\u00F3kuszt, a sikermutat\u00F3kat \u00E9s a ritmust. \u00C1tl\u00E1that\u00F3 szerz\u0151d\u00E9s \u00E9s titoktart\u00E1s."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "840a54a9-7d72-47db-9459-f9463fb5c8d4",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Coaching"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00E9theti rendszeress\u00E9g\u0171, 90 perces \u00FCl\u00E9sek. Struktur\u00E1lt gondolkod\u00E1s, terep-helyzetek elemz\u00E9se."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "066b9956-3ca0-435f-9381-7ca9f1d92c92",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "M\u00E9r\u00E9s"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Negyed\u00E9ves checkpoint, \u00E9rintettek visszajelz\u00E9se, fejl\u0151d\u00E9si \u00EDv dokument\u00E1l\u00E1sa."
                  }
                ]
              }
            ],
