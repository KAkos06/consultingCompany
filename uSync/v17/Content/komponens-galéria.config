    {
      "contentTypeKey": "b2222222-2222-2222-2222-222222222222",
      "key": "e4e174a0-16c7-468c-b5b8-cdda927f56ae",
      "values": [
        {
          "alias": "tag",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "02 - Megk\u00F6zel\u00EDt\u00E9s\u00FCnk"
        },
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "K\u00F6zvetlen figyelem. Val\u00F3di vezet\u0151i partners\u00E9g."
        },
        {
          "alias": "subtitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Az Executive Insight egy exkluz\u00EDv vezet\u0151i boutique tan\u00E1csad\u00F3. Nem hisz\u00FCnk a t\u00F6megk\u00E9pz\u00E9sekben \u00E9s a deleg\u00E1lt projektekben: minden partner\u00FCnkkel k\u00F6zvetlen\u00FCl, a legmagasabb szakmai \u00E9s szem\u00E9lyes odafigyel\u00E9ssel dolgozunk."
        },
        {
          "alias": "stat1Label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Vezet\u0151i f\u00F3kusz"
        },
        {
          "alias": "stat1Value",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "100%"
        },
        {
          "alias": "bullets",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "b7777777-7777-7777-7777-777777777771",
                "key": "8c75fc08-5386-4d39-a82f-daf72ecd954b",
                "values": [
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00F6zvetlen fels\u0151vezet\u0151i sparring \u00E9s d\u00F6nt\u00E9st\u00E1mogat\u00E1s"
                  }
                ]
              },
              {
                "contentTypeKey": "b7777777-7777-7777-7777-777777777771",
                "key": "38150dfa-5e78-41ff-86eb-77dc211f7dee",
                "values": [
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Felt\u00E9tlen diszkr\u00E9ci\u00F3 \u00E9s szigor\u00FA titoktart\u00E1s"
                  }
                ]
              },
              {
                "contentTypeKey": "b7777777-7777-7777-7777-777777777771",
                "key": "4d9f3851-7a62-4e04-b6c7-81e40540e7a4",
                "values": [
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Azonnal be\u00E9p\u00EDthet\u0151, gyakorlati eszk\u00F6zt\u00E1r"
                  }
                ]
              },
              {
                "contentTypeKey": "b7777777-7777-7777-7777-777777777771",
                "key": "99eb4073-3894-48c8-ba22-b38fbf79b9ae",
                "values": [
                  {
                    "alias": "text",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Agilis, szem\u00E9lyre szabott egy\u00FCttm\u0171k\u00F6d\u00E9si keretek"
                  },
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "icon": "mdi:shield-check",
                      "color": "#000000"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
