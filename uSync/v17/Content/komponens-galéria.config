    {
      "contentTypeKey": "b3333333-3333-3333-3333-333333333333",
      "key": "63c030de-41a9-4dfc-805d-b1039ffeaece",
      "values": [
        {
          "alias": "services",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "c5555555-5555-5555-5555-555555555551",
                "key": "75c1f8d7-5be9-4361-83eb-bbd52cddcd02",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Executive Coaching"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Egy\u00E9ni f\u00F3kusz\u00FA, intenz\u00EDv fejleszt\u00E9s C-szint\u0171 vezet\u0151knek, hogy a legnehezebb helyzetekben is magabiztosan d\u00F6ntsenek."
                  },
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "icon": "mdi:antenna",
                      "color": "#000000"
                    }
                  },
                  {
                    "alias": "tag",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Coaching"
                  }
                ]
              },
              {
                "contentTypeKey": "c5555555-5555-5555-5555-555555555551",
                "key": "0ccff005-82ac-4ac7-a13b-35c5d7828585",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Vezet\u0151s\u00E9gi Mentor\u00E1l\u00E1s"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "A menedzsment csapatok \u00F6sszehangol\u00E1sa, a k\u00F6z\u00F6s strat\u00E9giai v\u00EDzi\u00F3 kialak\u00EDt\u00E1sa \u00E9s a bels\u0151 fesz\u00FClts\u00E9gek felold\u00E1sa."
                  },
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "icon": "mdi:archive-arrow-down",
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "contentTypeKey": "c5555555-5555-5555-5555-555555555551",
                "key": "a299319f-7692-49dd-bfd2-4c69d667cf22",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Strat\u00E9giai Tan\u00E1csad\u00E1s"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ir\u00E1nyv\u00E1lt\u00E1sok, akviz\u00EDci\u00F3k vagy kr\u00EDzishelyzetek objekt\u00EDv, k\u00FCls\u0151 szak\u00E9rt\u0151i t\u00E1mogat\u00E1sa \u00E9s levez\u00E9nyl\u00E9se."
                  },
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "icon": "mdi:arrow-u-down-right-bold",
