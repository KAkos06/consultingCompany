                    "segment": null,
                    "value": "Nemzetk\u00F6zi Partnerh\u00E1l\u00F3zat"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00F6z\u00E9p-eur\u00F3pai jelenl\u00E9t ki\u00E9p\u00EDt\u00E9se \u00E9s hat\u00E1rokon \u00E1t\u00EDvel\u0151 d\u00F6nt\u00E9st\u00E1mogat\u00E1s."
