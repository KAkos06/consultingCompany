    {
      "contentTypeKey": "b7777777-7777-7777-7777-777777777777",
      "key": "485b466e-8a19-4cb3-ae42-51505d793651",
      "values": [
        {
          "alias": "testimonials",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "b7777777-7777-7777-7777-777777777701",
                "key": "ddc15bdf-cfbd-4384-90ff-83319e766ba2",
                "values": [
                  {
                    "alias": "quote",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Az Executive Insight csapata nem csak elm\u00E9leti tan\u00E1csokat adott, hanem olyan gyakorlati megk\u00F6zel\u00EDt\u00E9st, amit azonnal be tudtam \u00E9p\u00EDteni a heti vezet\u0151i \u00E9rtekezletekbe. A csapatom dinamik\u00E1ja egy h\u00F3nap alatt \u00E9rezhet\u0151en javult."
                  },
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Kov\u00E1cs G\u00E1bor"
                  },
                  {
                    "alias": "role",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Vez\u00E9rigazgat\u00F3, TechLogistics Kft."
                  }
                ]
              },
              {
