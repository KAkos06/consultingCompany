                    }
                  },
                  {
                    "alias": "tag",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Szakmai hitvall\u00E1s"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u201EA legnehezebb vezet\u0151i d\u00F6nt\u00E9sekben nem sablonokra van sz\u00FCks\u00E9g, hanem egy f\u00FCggetlen, megb\u00EDzhat\u00F3 gondolkod\u00F3t\u00E1rsra.\u201D"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "S\u00E1rosi Georgina - \u00DCgyvezet\u0151 igazgat\u00F3, Executive Insight"
                  }
                ]
              },
              {
                "contentTypeKey": "b5555555-1111-1111-1111-111111111111",
                "key": "15f22309-63ee-4406-931e-b11e1f0e7052",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "System.Collections.Generic.List\u00601[System.String]"
                  },
                  {
                    "alias": "tag",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u00C9rt\u00E9krend"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "100% diszkr\u00E9ci\u00F3 \u00E9s szem\u00E9lyes jelenl\u00E9t minden egy\u00FCttm\u0171k\u00F6d\u00E9sben."
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00F6zvetlen fels\u0151vezet\u0151i figyelem, juniorok n\u00E9lk\u00FCli boutique modell."
                  }
                ]
              },
              {
                "contentTypeKey": "b5555555-1111-1111-1111-111111111111",
                "key": "72ddc3fa-2f7b-4d3e-8f28-c551eb71f824",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "System.Collections.Generic.List\u00601[System.String]"
                  },
                  {
                    "alias": "tag",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "F\u00F3kusz"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Gyakorlati d\u00F6nt\u00E9si modellek a bizonytalans\u00E1g cs\u00F6kkent\u00E9s\u00E9re."
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Azonnal alkalmazhat\u00F3 strat\u00E9giai \u00E9s vezet\u00E9si eszk\u00F6zt\u00E1r."
                  }
                ]
              },
              {
                "contentTypeKey": "b5555555-1111-1111-1111-111111111111",
                "key": "2749447f-96d0-4450-bbfc-33d24a072438",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "System.Collections.Generic.List\u00601[System.String]"
                  },
                  {
                    "alias": "tag",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Konzult\u00E1ci\u00F3"
                  },
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "K\u00F6tetlen, 30 perces strat\u00E9giai diagnosztika."
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ismerj\u00FCk meg egym\u00E1st \u00E9s a felmer\u00FCl\u0151 vezet\u0151i kih\u00EDv\u00E1sokat."
                  }
                ]
              }
