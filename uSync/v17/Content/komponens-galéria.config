        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Vezet\u0151i coaching, ami val\u00F3di v\u00E1ltoz\u00E1st hoz",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Vezet\u0151i d\u00F6nt\u00E9sek tiszt\u00E1bban, strat\u00E9gia b\u00E1trabban.",
            "style": "H2"
          }
        },
        {
          "alias": "introduction",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EAz Executive Insight tapasztalt mentorok h\u00E1l\u00F3zata, akik C-szint\u0171 vezet\u0151ket \u00E9s vezet\u0151i csapatokat k\u00EDs\u00E9rnek a n\u00F6veked\u00E9s legkritikusabb pillanataiban. Foglalj diagnoszt\u003C/p\u003E"
          }
        },
        {
          "alias": "blockName",
          "culture": null,
