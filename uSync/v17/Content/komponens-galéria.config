    {
      "contentTypeKey": "a1111111-1111-1111-1111-111111111111",
      "key": "5c42686c-3d35-41ac-b339-93cbc4c66f1a",
      "values": [
        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Megk\u00F6zel\u00EDt\u00E9s\u00FCnk",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Egy meggy\u0151z\u0151d\u00E9s, amib\u0151l professzion\u00E1lis m\u0171hely lett.",
            "style": "H2"
          }
        },
        {
