                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Alap\u00EDt\u00E1s \u00E9s Boutique Modell"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "A pr\u00E9mium fels\u0151vezet\u0151i sparring modell elind\u00EDt\u00E1sa C-szint\u0171 d\u00F6nt\u00E9shoz\u00F3k sz\u00E1m\u00E1ra."
                  }
                ]
              },
              {
                "contentTypeKey": "a1212121-1212-1212-1212-121212121212",
