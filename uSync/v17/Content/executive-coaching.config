    {
      "contentTypeKey": "b6666666-6666-6666-6666-666666666666",
      "key": "e0000002-2222-2222-2222-222222222222",
      "values": [
        {
          "alias": "steps",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "e0000002-3333-3333-3333-000000000001",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Diagn\u00F3zis \u00E9s F\u00F3kusz"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "90 perces diszkr\u00E9t felt\u00E1r\u00E1s: a val\u00F3s fesz\u00FClts\u00E9gpontok, akad\u00E1lyok \u00E9s a legnagyobb megt\u00E9r\u00FCl\u00E9s\u0171 f\u00F3kuszter\u00FCletek azonos\u00EDt\u00E1sa."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "e0000002-3333-3333-3333-000000000002",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Strat\u00E9giai Terv"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Szem\u00E9lyre szabott fejleszt\u00E9si \u00E9s d\u00F6nt\u00E9si terv meghat\u00E1roz\u00E1sa egy\u00E9rtelm\u0171, m\u00E9rhet\u0151 c\u00E9lokkal \u00E9s m\u00E9rf\u00F6ldk\u00F6vekkel \u2014 sablonok n\u00E9lk\u00FCl."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "e0000002-3333-3333-3333-000000000003",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Intenz\u00EDv Sparring"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Rendszeres, struktur\u00E1lt 1:1 \u00FCl\u00E9sek \u00E9s val\u00F3s idej\u0171, diszkr\u00E9t d\u00F6nt\u00E9st\u00E1mogat\u00E1s a kritikus vezet\u0151i helyzetekben."
                  }
                ]
              },
              {
                "contentTypeKey": "b6666666-6666-6666-6666-666666666661",
                "key": "e0000002-3333-3333-3333-000000000004",
                "values": [
                  {
                    "alias": "title",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Konszolid\u00E1ci\u00F3 \u00E9s Hat\u00E1s"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Az \u00FAj vezet\u0151i m\u0171k\u00F6d\u00E9s be\u00E1gyaz\u00E1sa, szervezeti adapt\u00E1ci\u00F3ja \u00E9s az el\u00E9rt eredm\u00E9nyek hossz\u00FA t\u00E1v\u00FA stabiliz\u00E1l\u00E1sa."
                  }
                ]
              }
