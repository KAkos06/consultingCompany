        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Hogyan dolgozunk egy\u00FCtt?",
            "style": "H2"
          }
        },
        {
          "alias": "introduction",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EStruktur\u00E1lt, m\u00E9gis maxim\u00E1lisan rugalmas folyamat: minden egy\u00FCttm\u0171k\u00F6d\u00E9s az \u00D6n priorit\u00E1saihoz \u00E9s a szervezet val\u00F3s ritmus\u00E1hoz igazodik.\u003C/p\u003E"
          }
        },
