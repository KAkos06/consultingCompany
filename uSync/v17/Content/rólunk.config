                "values": [
                  {
                    "alias": "name",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "S\u00E1rosi Georgina"
                  },
                  {
                    "alias": "role",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u00DCgyvezet\u0151 igazgat\u00F3"
                  },
                  {
                    "alias": "description",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "Fels\u0151vezet\u0151i tan\u00E1csad\u00F3 \u00E9s executive coach. F\u0151 szakter\u00FClete a C-szint\u0171 d\u00F6nt\u00E9st\u00E1mogat\u00E1s, a vezet\u0151i magabiztoss\u00E1g er\u0151s\u00EDt\u00E9se \u00E9s a strat\u00E9giai transzform\u00E1ci\u00F3k levez\u00E9nyl\u00E9se."
                  },
