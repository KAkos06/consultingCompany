          "value": {
            "text": "Az Executive Insights csapata",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "12 \u00E9v, 240\u002B vezet\u0151, egyetlen k\u00FCldet\u00E9s.",
            "style": "H2"
          }
        },
        {
          "alias": "introduction",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETapasztalt mentorok h\u00E1l\u00F3zata, akik a magyar \u00E9s k\u00F6z\u00E9p-eur\u00F3pai piac C-szint\u0171 vezet\u0151it k\u00EDs\u00E9rik a n\u00F6veked\u00E9s legkritikusabb pillanataiban \u2014 diszkr\u00E9ten, m\u00E9lyen, m\u00E9rhet\u0151 eredm\u00E9nnyel.\u003C/p\u003E"
          }
        },
        {
          "alias": "showHeaderOptions",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
        },
        {
          "alias": "blockName",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Fejl\u00E9c"
        }
      ]
    },
    {
      "contentTypeKey": "a1111111-1111-1111-1111-111111111111",
      "key": "32cfc58d-3e63-4c6d-95e5-af9db02b10e6",
      "values": [
        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "A t\u00F6rt\u00E9net\u00FCnk",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Egy meggy\u0151z\u0151d\u00E9s, amib\u0151l c\u00E9g lett.",
            "style": "H2"
          }
        },
        {
          "alias": "blockName",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00F6rt\u00E9net\u00FCnk"
        },
        {
          "alias": "showHeaderOptions",
          "culture": null,
