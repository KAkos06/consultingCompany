          "value": "dark"
        },
        {
          "alias": "width",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "wide"
        },
        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Az Executive Insight k\u00FCldet\u00E9se",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "F\u00FCggetlen n\u00E9z\u0151pont. Tiszta strat\u00E9giai d\u00F6nt\u00E9sek.",
            "style": "H2"
          }
        },
        {
          "alias": "introduction",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EC-szint\u0171 vezet\u0151k \u00E9s d\u00F6nt\u00E9shoz\u00F3k diszkr\u00E9t strat\u00E9giai partnere vagyunk a n\u00F6veked\u00E9s, az \u00E1talakul\u00E1s \u00E9s a kritikus \u00FCzleti m\u00E9rf\u00F6ldk\u00F6vek idej\u00E9n.\u003C/p\u003E"
          }
        },
        {
          "alias": "showHeaderOptions",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
        },
        {
          "alias": "blockName",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Fejl\u00E9c"
        },
        {
          "alias": "textAlignment",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Left"
        }
      ]
    },
    {
      "contentTypeKey": "a1111111-1111-1111-1111-111111111111",
      "key": "32cfc58d-3e63-4c6d-95e5-af9db02b10e6",
      "values": [
        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Megk\u00F6zel\u00EDt\u00E9s\u00FCnk",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Egy meggy\u0151z\u0151d\u00E9s, amib\u0151l professzion\u00E1lis m\u0171hely lett.",
            "style": "H2"
          }
        },
        {
          "alias": "blockName",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "T\u00F6rt\u00E9net\u00FCnk"
        },
        {
          "alias": "showHeaderOptions",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
        },
        {
          "alias": "padding",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "small"
        },
        {
          "alias": "backgroundColor",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "cream"
        },
        {
          "alias": "width",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "center"
        }
      ]
    },
    {
      "contentTypeKey": "a1414141-1414-1414-1414-141414141414",
      "key": "2839c01e-aaef-49fb-bfce-73ad33db5253",
      "values": [
        {
          "alias": "richText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EAz Executive Insight az\u00E9rt j\u00F6tt l\u00E9tre, hogy alternat\u00EDv\u00E1t ny\u00FAjtson a szem\u00E9lytelen, sablonos nagyv\u00E1llalati tan\u00E1csad\u00E1ssal szemben. Meggy\u0151z\u0151d\u00E9s\u00FCnk, hogy a legfontosabb vezet\u0151i d\u00F6nt\u00E9seket nem sablonos prezent\u00E1ci\u00F3k \u00E9s junior tan\u00E1csad\u00F3k viszik sikerre, hanem a m\u00E9ly szakmai jelenl\u00E9t, a felt\u00E9tlen diszkr\u00E9ci\u00F3 \u00E9s a val\u00F3di 1:1 sparring partners\u00E9g.\u003C/p\u003E\u003Cp\u003E\u003C/p\u003E\u003Cp\u003EBoutique m\u0171helyk\u00E9nt minden megb\u00EDz\u00E1sunk egyedi: k\u00F6zvetlen, szem\u00E9lyes felel\u0151ss\u00E9gv\u00E1llal\u00E1ssal dolgozunk, ahol a fels\u0151vezet\u0151 kih\u00EDv\u00E1sai az els\u0151 napt\u00F3l a legmagasabb szint\u0171, dedik\u00E1lt figyelmet kapj\u00E1k.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a1111111-1111-1111-1111-111111111111",
      "key": "44444444-5555-6666-7777-888888888881",
      "values": [
        {
          "alias": "padding",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "small"
        },
        {
          "alias": "backgroundColor",
          "culture": null,
