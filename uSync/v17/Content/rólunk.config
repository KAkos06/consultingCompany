          "editorAlias": null,
          "segment": null,
          "value": "wide"
        },
        {
          "alias": "secondaryHeading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Vezet\u00E9s",
            "style": "M"
          }
        },
        {
          "alias": "heading",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "text": "Szem\u00E9lyes figyelem. Val\u00F3di felel\u0151ss\u00E9gv\u00E1llal\u00E1s.",
            "style": "H2"
          }
        },
        {
          "alias": "introduction",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EA boutique modell\u00FCnk l\u00E9nyege, hogy minden vezet\u0151i folyamatot k\u00F6zvetlen\u00FCl tapasztalt szakember vezet.\u003C/p\u003E"
          }
        },
        {
          "alias": "showHeaderOptions",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "1"
